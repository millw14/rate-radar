# Never commit .env.local or .dev.vars. No wallet private key belongs on the server.
HELIUS_API_KEY=
# This first integration is intentionally pinned to Solana devnet.
RINGS_NETWORK=devnet
RINGS_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Generate a 32-byte base64 key for encryption of payment-scoped disclosure records.
RECEIPT_ENCRYPTION_KEY=

# Vercel: server-only credentials provided by the Turso Marketplace integration.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional exact, comma-separated HTTPS origins; defaults to the serving origin.
AUTH_ALLOWED_ORIGINS=
# Set only when testing the wallet-session adapter on local HTTP.
# AUTH_ALLOW_INSECURE_LOCALHOST=true
