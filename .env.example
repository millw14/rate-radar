# Never commit .env.local or .dev.vars. No wallet private key belongs on the server.
HELIUS_API_KEY=
# Keep development on devnet. Production is explicitly mainnet-beta only after release verification.
RINGS_NETWORK=devnet
RINGS_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Mainnet USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Pause new deal payments while preserving withdrawals and saved-payment recovery.
PAYMENTS_PAUSED=false
# Production defaults to 100 USDC per payment. Decimal string; never a floating point calculation.
# PAYMENT_LIMIT_USDC=100
# Generate a 32-byte base64 key for encryption of payment-scoped disclosure records.
RECEIPT_ENCRYPTION_KEY=

# Vercel: server-only credentials provided by the Turso Marketplace integration.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Mainnet selects this separate database; never point it at the devnet database.
MAINNET_TURSO_DATABASE_URL=
MAINNET_TURSO_AUTH_TOKEN=
# Random server-only bearer token (at least 32 characters) for scheduled reconciliation.
CRON_SECRET=
# Optional exact, comma-separated HTTPS origins; defaults to the serving origin.
AUTH_ALLOWED_ORIGINS=
# Set only when testing the wallet-session adapter on local HTTP.
# AUTH_ALLOW_INSECURE_LOCALHOST=true
